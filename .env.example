# Salin file ini menjadi .env dan isi semua nilainya. Jangan commit .env.

# Koneksi database (satu-satunya sumber koneksi — dipakai untuk migration,
# seed, DAN runtime aplikasi, supaya tidak ada dua jalur yang bisa beda).
DATABASE_URL="mysql://root:your_password@localhost:3306/education_app"

# JWT
JWT_ACCESS_SECRET="ganti-dengan-random-string-panjang"
JWT_REFRESH_SECRET="ganti-dengan-random-string-panjang-yang-berbeda"

# CORS — daftar origin frontend yang diizinkan, pisahkan dengan koma.
# Kosong = tidak ada origin cross-site yang diizinkan (fail closed).
CORS_ORIGIN="http://localhost:5173"

PORT=3000
